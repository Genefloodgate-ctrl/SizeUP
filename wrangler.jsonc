{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sizeup",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./docs"
  },
  // Cloudflare creates the DNS records and issues the TLS certificate for these
  // itself on deploy — there is nothing to add by hand in the DNS tab.
  "routes": [
    { "pattern": "sizeup.fun", "custom_domain": true },
    { "pattern": "www.sizeup.fun", "custom_domain": true }
  ]
}
